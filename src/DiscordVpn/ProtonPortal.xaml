<Window x:Class="DiscordVpn.ProtonPortal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="discSapo · Configurar Proton" Icon="Assets/Logo.ico" Width="1100" Height="800" MinWidth="750" MinHeight="550" WindowStartupLocation="CenterOwner" Background="#F2F3F7" Foreground="#1C1C1E" FontFamily="Segoe UI">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" Padding="24,18" BorderBrush="#E7E9EF" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="Configure sua conexão" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Na Proton: Downloads → WireGuard → Criar → Download" Foreground="#747780" Margin="0,6,0,12" FontSize="13" TextWrapping="Wrap"/>
        <Border CornerRadius="12" Background="#EEF5FF" Padding="12,10" Margin="0,0,0,14">
          <TextBlock x:Name="PortalStatus" Text="Ao baixar, a configuração será aplicada e a conexão iniciará automaticamente." Foreground="#2362A6" FontSize="13" TextWrapping="Wrap"/>
        </Border>
        <WrapPanel>
          <Button x:Name="PortalBack" Content="‹" ToolTip="Voltar" Click="Back_Click" IsEnabled="False" Style="{StaticResource NavigationButton}"/>
          <Button x:Name="PortalForward" Content="›" ToolTip="Avançar" Click="Forward_Click" IsEnabled="False" Style="{StaticResource NavigationButton}"/>
          <Button Content="Reabrir portal" Click="Reload_Click" Style="{StaticResource QuietButton}"/>
          <Button x:Name="UseConfiguration" Content="Voltar à conexão" Click="Close_Click" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Cancelar" Click="Close_Click" Style="{StaticResource QuietButton}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <wv:WebView2 x:Name="PortalView"/>
  </DockPanel>
</Window>
