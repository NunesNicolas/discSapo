<Window x:Class="DiscordVpn.ProtonLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Conectar com Proton" Width="480" Height="640" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F2F3F7" FontFamily="Segoe UI" Icon="Assets/Logo.ico">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="24" Padding="26">
      <StackPanel>
        <TextBlock Text="Sua conta. Sua conexão." FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock x:Name="Hint" Text="Entre com sua conta Proton. Sua senha não será salva." Foreground="#747780" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel x:Name="Credentials">
          <TextBlock Text="Usuário ou e-mail" Margin="0,0,0,6"/>
          <TextBox x:Name="Username" Padding="10" FontSize="14" MaxLength="254" Margin="0,0,0,14"/>
          <TextBlock Text="Senha Proton" Margin="0,0,0,6"/>
          <PasswordBox x:Name="Password" Padding="10" FontSize="14" Margin="0,0,0,18"/>
          <Button x:Name="LoginButton" Content="Entrar" Click="Login_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
        <StackPanel x:Name="TwoFactorPanel" Visibility="Collapsed">
          <TextBlock Text="Código de 6 dígitos do autenticador" Margin="0,0,0,8"/>
          <PasswordBox x:Name="TwoFactor" MaxLength="6" Padding="10" Margin="0,0,0,14"/>
          <Button Content="Confirmar código" Click="Code_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
        <StackPanel x:Name="Selection" Visibility="Collapsed">
          <CheckBox x:Name="FreeOnly" Content="Somente servidores gratuitos" IsChecked="True" Margin="0,0,0,16" Click="Filter_Click"/>
          <TextBlock Text="País de saída" Margin="0,0,0,6"/>
          <ComboBox x:Name="Countries" DisplayMemberPath="Label" SelectedValuePath="Code" Padding="10" FontSize="14" Margin="0,0,0,12"/>
          <TextBlock x:Name="PlanHint" Text="Consultando os países disponíveis para sua conta." Foreground="#747780" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"/>
          <Button x:Name="UseButton" Content="Conectar e abrir Discord" Click="Use_Click" Style="{StaticResource PrimaryButton}"/>
          <Button Content="Esquecer conta neste PC" Click="Forget_Click" Style="{StaticResource QuietButton}" Margin="0,10,0,0"/>
        </StackPanel>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#747780" FontSize="13" Margin="0,20,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <Button Content="Abrir portal Proton" Click="Portal_Click" Style="{StaticResource QuietButton}"/>
      <TextBlock Text="Integração independente, não afiliada à Proton." FontSize="11" Foreground="#93959D" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
  </Grid>
</Window>
