<Window x:Class="DiscordVpn.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="discSapo" Icon="Assets/Logo.ico" Width="1280" Height="850" MinWidth="850" MinHeight="650" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <Border x:Name="AppHeader" Padding="22,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
        <StackPanel>
          <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Ocultar controles" Click="ToggleControls_Click" Style="{StaticResource QuietButton}" Margin="0"/>
            <Image x:Name="HeaderLogo" Width="42" Height="42" Margin="0,0,10,0" DockPanel.Dock="Left"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="discSapo" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatusText" Text="Tudo começa com uma conexão." Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BackButton" Content="‹" ToolTip="Voltar" Click="Back_Click" IsEnabled="False" Style="{StaticResource NavigationButton}"/>
              <Button x:Name="ForwardButton" Content="›" ToolTip="Avançar" Click="Forward_Click" IsEnabled="False" Style="{StaticResource NavigationButton}"/>
              <Button x:Name="ReloadButton" Content="↻" ToolTip="Recarregar" Click="Reload_Click" IsEnabled="False" Style="{StaticResource NavigationButton}"/>
              <Button x:Name="ImportButton" Content="Importar arquivo" Click="Import_Click" Style="{StaticResource QuietButton}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource InsetBrush}" CornerRadius="16" Padding="7" HorizontalAlignment="Left" Margin="8,0,12,0">
              <StackPanel Orientation="Horizontal">
                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AvatarBrush}" Margin="0,0,10,0">
                  <Grid>
                    <TextBlock x:Name="AccountInitial" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="AccountIcon" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Width="158">
                  <TextBlock x:Name="AccountName" Text="Conta Proton" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  <Button x:Name="ProtonButton" Content="Conectar com Proton" Click="Proton_Click" Style="{StaticResource QuietButton}" Padding="0,2" Margin="0" MinHeight="22" HorizontalAlignment="Left"/>
                </StackPanel>
                <Button x:Name="AccountMenuButton" Content="⌄" ToolTip="Ações da conta Proton" Click="AccountMenu_Click" Style="{StaticResource QuietButton}" Padding="9,0" Margin="4,0,0,0">
                  <Button.ContextMenu><ContextMenu>
                    <MenuItem x:Name="PortalButton" Header="Abrir portal Proton" Click="Portal_Click"/>
                    <MenuItem Header="Conectar com Proton" Click="Proton_Click"/>
                  </ContextMenu></Button.ContextMenu>
                </Button>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button x:Name="ConnectButton" Content="Conectar  →" Click="Connect_Click" IsEnabled="False" Padding="24,12" Margin="0" Style="{StaticResource PrimaryButton}"/>
              <Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect_Click" Visibility="Collapsed" IsEnabled="False" Margin="0,3,0,0" Padding="8,2" MinHeight="24" Style="{StaticResource QuietButton}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
    <Grid Grid.Row="1" x:Name="BrowserHost">
      <Border x:Name="Welcome" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Margin="24" Padding="36" Background="{DynamicResource SurfaceBrush}" CornerRadius="24" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <StackPanel>
          <Image x:Name="WelcomeLogo" Width="110" Height="110" Margin="0,0,0,18"/>
          <TextBlock Text="Seu Discord, do seu jeito." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock Text="Entre na sua conta Proton, escolha um país e abra o Discord. Nós cuidamos da conexão." Margin="0,12,0,26" FontSize="15" LineHeight="23" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
          <Border Background="{DynamicResource InsetBrush}" CornerRadius="16" Padding="20">
            <StackPanel>
              <TextBlock Text="SUA CONEXÃO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
              <TextBlock x:Name="ConfigText" Text="Pronto para começar" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailText" Text="Use Entrar na Proton acima. O portal e a importação de arquivo também estão disponíveis." Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    <Popup x:Name="HoverControls" PlacementTarget="{Binding ElementName=BrowserHost}" Placement="Relative" AllowsTransparency="True" StaysOpen="True">
      <Border Width="{Binding ActualWidth, ElementName=BrowserHost}" Height="44" Background="{DynamicResource SurfaceBrush}" Padding="16,5">
        <DockPanel>
          <Button x:Name="RestoreControls" DockPanel.Dock="Right" Content="Revelar controles ▾" Click="ToggleControls_Click" FontSize="11" Padding="10,2" MinHeight="26" Margin="0"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="←" Click="Back_Click" IsEnabled="{Binding IsEnabled, ElementName=BackButton}" Width="30" Padding="0" MinHeight="26" ToolTip="Voltar"/>
            <Button Content="→" Click="Forward_Click" IsEnabled="{Binding IsEnabled, ElementName=ForwardButton}" Width="30" Padding="0" MinHeight="26" ToolTip="Avançar"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Popup>
    <Border x:Name="AppFooter" Grid.Row="2" Padding="24,12">
      <TextBlock Text="Seu espaço para conversar." HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
    </Border>
  </Grid>
</Window>
